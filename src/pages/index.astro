---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem | GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="battle-arena">
			<header class="hero">
				<p class="eyebrow">GitHub Contribution Battle Arena</p>
				<h1>MONA MAYHEM</h1>
				<p>Choose your players. Compare their contribution power. Let the battle begin.</p>
			</header>

			<section class="battle-controls" aria-labelledby="battle-controls-title">
				<h2 id="battle-controls-title">Choose your fighters</h2>
				<form id="battle-form">
					<label>
						<span>Player 1</span>
						<input
							id="player-one-input"
							name="playerOne"
							type="text"
							placeholder="octocat"
							autocomplete="off"
							required
						/>
					</label>
					<label>
						<span>Player 2</span>
						<input
							id="player-two-input"
							name="playerTwo"
							type="text"
							placeholder="torvalds"
							autocomplete="off"
							required
						/>
					</label>
					<button id="battle-button" type="submit">BATTLE!</button>
				</form>
				<p id="status-message" class="status-message" role="status" aria-live="polite"></p>
			</section>

			<section id="scoreboard" class="scoreboard" aria-labelledby="scoreboard-title" hidden>
				<p class="eyebrow">Battle result</p>
				<h2 id="scoreboard-title">READY...</h2>
				<p id="scoreboard-detail"></p>
			</section>

			<section id="arena" class="players-grid" aria-label="Contribution battle arena">
				<article class="player-panel" data-player-panel="one">
					<div class="player-heading">
						<img class="avatar" data-avatar alt="" hidden />
						<div>
							<p class="player-label">PLAYER 1</p>
							<h2 data-username>Awaiting challenger</h2>
							<a data-profile target="_blank" rel="noreferrer" hidden>View profile</a>
						</div>
					</div>
					<div class="contribution-section">
						<h3>Contribution grid</h3>
						<div class="contribution-grid" data-grid aria-label="Player 1 contribution calendar"></div>
					</div>
					<dl class="stats-list">
						<div><dt>Total contributions</dt><dd data-stat="total">—</dd></div>
						<div><dt>Longest streak</dt><dd data-stat="longest">—</dd></div>
						<div><dt>Current streak</dt><dd data-stat="current">—</dd></div>
						<div><dt>Peak day</dt><dd data-stat="peak">—</dd></div>
						<div><dt>Consistency</dt><dd data-stat="consistency">—</dd></div>
					</dl>
				</article>

				<article class="player-panel" data-player-panel="two">
					<div class="player-heading">
						<img class="avatar" data-avatar alt="" hidden />
						<div>
							<p class="player-label">PLAYER 2</p>
							<h2 data-username>Awaiting challenger</h2>
							<a data-profile target="_blank" rel="noreferrer" hidden>View profile</a>
						</div>
					</div>
					<div class="contribution-section">
						<h3>Contribution grid</h3>
						<div class="contribution-grid" data-grid aria-label="Player 2 contribution calendar"></div>
					</div>
					<dl class="stats-list">
						<div><dt>Total contributions</dt><dd data-stat="total">—</dd></div>
						<div><dt>Longest streak</dt><dd data-stat="longest">—</dd></div>
						<div><dt>Current streak</dt><dd data-stat="current">—</dd></div>
						<div><dt>Peak day</dt><dd data-stat="peak">—</dd></div>
						<div><dt>Consistency</dt><dd data-stat="consistency">—</dd></div>
					</dl>
				</article>
			</section>
		</main>

		<script>
			const form = document.querySelector('#battle-form');
			const battleButton = document.querySelector('#battle-button');
			const statusMessage = document.querySelector('#status-message');
			const scoreboard = document.querySelector('#scoreboard');
			const scoreboardTitle = document.querySelector('#scoreboard-title');
			const scoreboardDetail = document.querySelector('#scoreboard-detail');

			const setStatus = (message, type = '') => {
				statusMessage.textContent = message;
				statusMessage.className = `status-message ${type}`.trim();
			};

			const calculateStats = (weeks) => {
				const days = weeks.flatMap((week) => week.days);
				const activeDays = days.filter((day) => day.count > 0);
				let longest = 0;
				let current = 0;
				let streak = 0;
				let previousDate;

				for (const day of days) {
					const date = new Date(`${day.date}T00:00:00Z`);
					const isConsecutive = previousDate && date - previousDate === 86400000;
					streak = day.count > 0 && (isConsecutive || !previousDate) ? streak + 1 : day.count > 0 ? 1 : 0;
					longest = Math.max(longest, streak);
					previousDate = date;
				}

				for (let index = days.length - 1; index >= 0 && days[index].count > 0; index -= 1) {
					current += 1;
				}

				const total = days.reduce((sum, day) => sum + day.count, 0);
				const peak = days.reduce((best, day) => (day.count > best.count ? day : best), { count: 0, date: '—' });

				return {
					total,
					longest,
					current,
					peak: peak.count ? `${peak.count} (${peak.date})` : '—',
					consistency: days.length ? `${Math.round((activeDays.length / days.length) * 100)}%` : '0%',
				};
			};

			const renderPlayer = (panel, data) => {
				const username = data.username;
				const stats = calculateStats(data.weeks);
				const avatar = panel.querySelector('[data-avatar]');
				const profile = panel.querySelector('[data-profile]');
				const grid = panel.querySelector('[data-grid]');

				panel.querySelector('[data-username]').textContent = username;
				avatar.src = `https://github.com/${encodeURIComponent(username)}.png?size=96`;
				avatar.alt = `${username} avatar`;
				avatar.hidden = false;
				profile.href = `https://github.com/${encodeURIComponent(username)}`;
				profile.textContent = `github.com/${username}`;
				profile.hidden = false;
				panel.querySelector('[data-stat="total"]').textContent = stats.total.toLocaleString();
				panel.querySelector('[data-stat="longest"]').textContent = `${stats.longest} days`;
				panel.querySelector('[data-stat="current"]').textContent = `${stats.current} days`;
				panel.querySelector('[data-stat="peak"]').textContent = stats.peak;
				panel.querySelector('[data-stat="consistency"]').textContent = stats.consistency;
				grid.replaceChildren();

				for (const week of data.weeks) {
					const weekElement = document.createElement('div');
					weekElement.className = 'week';
					weekElement.setAttribute('role', 'group');
					weekElement.setAttribute('aria-label', `Week ${week.week + 1}`);

					for (const day of week.days) {
						const dayElement = document.createElement('span');
						dayElement.className = `day level-${day.level}`;
						dayElement.title = `${day.date}: ${day.count} contributions`;
						dayElement.setAttribute('aria-label', dayElement.title);
						weekElement.append(dayElement);
					}

					grid.append(weekElement);
				}

				return stats;
			};

			const fetchContributions = async (username) => {
				const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
				const body = await response.json();

				if (!response.ok) {
					throw new Error(body.error || `Unable to load ${username}`);
				}

				return body;
			};

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const playerOne = document.querySelector('#player-one-input').value.trim();
				const playerTwo = document.querySelector('#player-two-input').value.trim();

				if (!playerOne || !playerTwo) {
					setStatus('Enter a GitHub username for both players.', 'error');
					return;
				}

				battleButton.disabled = true;
				scoreboard.hidden = true;
				setStatus('Loading contribution data...');

				try {
					const [playerOneData, playerTwoData] = await Promise.all([
						fetchContributions(playerOne),
						fetchContributions(playerTwo),
					]);
					const panels = document.querySelectorAll('[data-player-panel]');
					const playerOneStats = renderPlayer(panels[0], playerOneData);
					const playerTwoStats = renderPlayer(panels[1], playerTwoData);
					const playerOneScore = playerOneStats.total;
					const playerTwoScore = playerTwoStats.total;

					scoreboard.hidden = false;
					if (playerOneScore === playerTwoScore) {
						scoreboardTitle.textContent = 'DRAW GAME!';
						scoreboardDetail.textContent = `${playerOne} and ${playerTwo} are evenly matched.`;
					} else {
						const winner = playerOneScore > playerTwoScore ? playerOne : playerTwo;
						const margin = Math.abs(playerOneScore - playerTwoScore).toLocaleString();
						scoreboardTitle.textContent = `${winner} WINS!`;
						scoreboardDetail.textContent = `${margin} more contributions claim the victory.`;
					}
					setStatus('Battle complete!');
				} catch (error) {
					setStatus(error instanceof Error ? error.message : 'Something went wrong. Try again.', 'error');
				} finally {
					battleButton.disabled = false;
				}
			});
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		background: #120d2b;
		color: #f8f4ff;
		font-family: "Courier New", monospace;
	}

	.battle-arena {
		width: min(1180px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 3rem 0 5rem;
	}

	.hero,
	.battle-controls,
	.scoreboard {
		text-align: center;
	}

	.hero {
		margin-bottom: 2rem;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 0.75rem;
		color: #ffdd57;
		font-size: clamp(2.2rem, 8vw, 5rem);
		letter-spacing: 0.08em;
		text-shadow: 5px 5px #ed4b9b;
	}

	h2 {
		color: #ffdd57;
	}

	.eyebrow,
	.player-label {
		margin-bottom: 0.5rem;
		color: #7cf5ff;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.battle-controls,
	.scoreboard,
	.player-panel {
		border: 3px solid #7cf5ff;
		background: #1d1640;
		box-shadow: 8px 8px 0 #070511;
	}

	.battle-controls {
		padding: 1.5rem;
	}

	form {
		display: grid;
		grid-template-columns: repeat(2, 1fr) auto;
		gap: 1rem;
		align-items: end;
		text-align: left;
	}

	label span {
		display: block;
		margin-bottom: 0.5rem;
		color: #ffb9e2;
		font-weight: 700;
	}

	input,
	button {
		width: 100%;
		border: 2px solid #ffdd57;
		padding: 0.85rem 1rem;
		font: inherit;
	}

	input {
		background: #0e0921;
		color: #fff;
	}

	button {
		cursor: pointer;
		background: #ed4b9b;
		color: #fff;
		font-weight: 700;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.6;
	}

	.status-message {
		min-height: 1.25rem;
		margin: 1rem 0 0;
		color: #7cf5ff;
	}

	.status-message.error {
		color: #ff8e8e;
	}

	.scoreboard {
		margin: 2rem 0;
		padding: 1.5rem;
		border-color: #ffdd57;
	}

	.scoreboard h2 {
		margin-bottom: 0.5rem;
		font-size: clamp(1.5rem, 4vw, 2.5rem);
	}

	.players-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	.player-panel {
		padding: 1.25rem;
	}

	.player-heading {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.player-heading h2 {
		margin-bottom: 0.5rem;
		overflow-wrap: anywhere;
	}

	.player-heading a {
		color: #7cf5ff;
		font-size: 0.8rem;
	}

	.avatar {
		width: 64px;
		height: 64px;
		border: 3px solid #ffdd57;
		image-rendering: pixelated;
	}

	.contribution-section h3 {
		color: #ffb9e2;
		font-size: 1rem;
	}

	.contribution-grid {
		display: flex;
		gap: 3px;
		min-height: 86px;
		overflow-x: auto;
		padding: 0.75rem;
		background: #0e0921;
	}

	.week {
		display: grid;
		grid-template-rows: repeat(7, 9px);
		gap: 3px;
		flex: 0 0 9px;
	}

	.day {
		display: block;
		width: 9px;
		height: 9px;
		background: #342b59;
	}

	.level-1 {
		background: #385e66;
	}

	.level-2 {
		background: #37a981;
	}

	.level-3 {
		background: #7cdb75;
	}

	.level-4 {
		background: #ffdd57;
	}

	.stats-list {
		display: grid;
		gap: 0.65rem;
		margin: 1.5rem 0 0;
	}

	.stats-list div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px dashed #514578;
		padding-bottom: 0.45rem;
	}

	dt {
		color: #c6bddf;
	}

	dd {
		margin: 0;
		color: #ffdd57;
		font-weight: 700;
		text-align: right;
	}

	@media (max-width: 760px) {
		.battle-arena {
			padding-top: 2rem;
		}

		form,
		.players-grid {
			grid-template-columns: 1fr;
		}

		button {
			margin-top: 0.25rem;
		}
	}
</style>
